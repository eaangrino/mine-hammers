{
  "schemaVersion": 1,
  "id": "mine-hammers",
  "version": "${version}",
  "name": "Mine Hammers",
  "description": "A Minecraft mod that adds hammers to the game, allowing players to mine multiple blocks at once.",
  "authors": ["eaangrino"],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/mine-hammers/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["eaangrino.MineHammers"],
    "client": ["eaangrino.MineHammersClient"],
    "modmenu": ["eaangrino.client.ModMenuIntegration"],
    "fabric-datagen": ["eaangrino.MineHammersDataGenerator"]
  },
  "mixins": [
    "mine-hammers.mixins.json",
    {
      "config": "mine-hammers.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
